[Unit]
Description=AstianGO recoverable ingestion history
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/Development/astiango/stract
ExecStart=/usr/bin/python3 scripts/ingestion-retention.py --run
Restart=on-failure
RestartSec=15
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=256M
TasksMax=12
TimeoutStopSec=90

[Install]
WantedBy=default.target
