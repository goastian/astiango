{
  "name": "@astian/crawler-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local operational dashboard for the Stract crawler",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --fail-on-warnings --tsconfig ./tsconfig.json",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "npm run build && node test/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "4.0.0",
    "@types/node": "^20.11.19",
    "svelte": "5.1.9",
    "svelte-check": "4.0.5",
    "typescript": "^5.5.0",
    "vite": "^5.4.4"
  }
}
