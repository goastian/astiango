# Private upstream; never sent to the browser. Same-origin public adapter /api/web/search.
SEARCH_API_ORIGIN=http://127.0.0.1:3210
# Existing legacy API routes stay same-origin unless explicitly configured.
PUBLIC_API_BASE=
# Vite uses the checked-in/generated WASM package; opt in to Rust source watching.
WATCH_WASM=false
# Raw queries enabled for this local Vite session; production defaults to no raw queries.
FRONTEND_CAPTURE_QUERIES=false
# Optional rates for a partial variable-cost estimate. No monetary value is invented.
# SEARCH_CPU_HOUR_PRICE=
# SEARCH_EGRESS_GIB_PRICE=
# SEARCH_PRICE_CURRENCY=USD
